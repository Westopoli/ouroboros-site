---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Ouroboros Manifold</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      :root {
        --bg: #0d0f14;
        --bg-raised: #161923;
        --fg: #e8e6df;
        --fg-dim: #9a9aa6;
        --accent: #d98e3a;
        --border: #2a2e3a;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        line-height: 1.55;
      }
      .banner {
        background: #3a2a10;
        color: #f0c98a;
        text-align: center;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      nav a {
        color: var(--fg-dim);
        text-decoration: none;
        font-size: 0.9rem;
      }
      nav a:hover, nav a.active { color: var(--fg); }
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
      h1 { font-size: 1.8rem; margin-bottom: 0.25rem; }
      h2 { font-size: 1.2rem; margin-top: 2rem; color: var(--accent); }
      p { color: var(--fg); }
      a { color: var(--accent); }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .card {
        border: 1px solid var(--border);
        background: var(--bg-raised);
        border-radius: 8px;
        padding: 1rem 1.2rem;
        text-decoration: none;
        display: block;
      }
      .card h3 { margin: 0 0 0.4rem; color: var(--fg); font-size: 1rem; }
      .card .meta { color: var(--fg-dim); font-size: 0.8rem; }
      table { border-collapse: collapse; width: 100%; margin-top: 1rem; display: block; overflow-x: auto; max-width: 100%; }
      th, td { border: 1px solid var(--border); padding: 0.5rem 0.7rem; text-align: left; font-size: 0.9rem; }
      th { background: var(--bg-raised); }
      footer {
        text-align: center;
        color: var(--fg-dim);
        font-size: 0.8rem;
        padding: 2rem 1rem;
      }
      img { max-width: 100%; border-radius: 6px; }
    </style>
  </head>
  <body>
    <div class="banner">Private playtest — please do not share this link.</div>
    <nav>
      <a href="/">Home</a>
      <a href="/offers/">Offers</a>
      <a href="/layers/">Layer demo</a>
      <a href="/roadmap/">Roadmap</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer>Everything shown here is a target, not a screenshot of a finished game.</footer>
  </body>
</html>

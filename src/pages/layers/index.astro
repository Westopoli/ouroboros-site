---
import Base from "../../layouts/Base.astro";
---
<Base title="Layer demo">
  <h1>The layer system — interactive demo</h1>
  <p style="color: var(--fg-dim)">
    This is Westley's idea under evaluation in the design phase, not a build. Five stacked layers, illustrative
    elevations (the bible's own 5-layer numbers are not yet decided — see <code>E-01</code>'s open flags). Click a
    unit to select it; a grid lights on its layer and fades with layer distance, per S-005's real numbers
    (adjacent factor 0.50, two layers away 0.20, three or more away: nothing). Press <kbd>[</kbd> and <kbd>]</kbd>
    to move the selected unit down or up a layer, tweened over that unit type's transition duration (S-004).
  </p>
  <div id="canvas-wrap" style="position: relative; width: 100%; aspect-ratio: 16 / 10; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-top: 1rem;">
    <canvas id="scene" style="display:block; width:100%; height:100%;"></canvas>
    <div id="hint" style="position:absolute; bottom:0.6rem; left:0.8rem; font-size:0.8rem; color:#cfcfcf; background:rgba(0,0,0,0.5); padding:0.3rem 0.6rem; border-radius:4px;">
      Loading models…
    </div>
  </div>

  <script>
    import * as THREE from "three";
    import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
    import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";

    const LAYER_COUNT = 5;
    const LAYER_HEIGHT_WU = 20; // illustrative spacing only — E-01's real elevation mapping is an open flag
    const LAYER_SIZE_WU = 40;

    // R-005: cross-layer visibility factor by layer distance (real numbers, not illustrative)
    const VISIBILITY_FACTOR: Record<number, number> = { 0: 1.0, 1: 0.5, 2: 0.2 };

    // R-004-01: transition duration per unit type, seconds (current config, Q-004-01 not yet confirmed)
    const TRANSITION_SECONDS: Record<string, number> = {
      raider: 1.0,
      interceptor: 1.2,
      vanguard: 2.5,
    };

    const canvas = document.getElementById("scene") as HTMLCanvasElement;
    const wrap = document.getElementById("canvas-wrap") as HTMLDivElement;
    const hint = document.getElementById("hint") as HTMLDivElement;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0d0f14);

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 1000);
    camera.position.set(90, 90, 140);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    const dpr = Math.min(window.devicePixelRatio, 2);
    renderer.setPixelRatio(dpr);

    function resize() {
      const w = wrap.clientWidth;
      const h = wrap.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    window.addEventListener("resize", resize);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.target.set(0, LAYER_HEIGHT_WU * 2, 0);
    controls.enableDamping = true;

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));
    const sun = new THREE.DirectionalLight(0xffffff, 0.8);
    sun.position.set(60, 120, 40);
    scene.add(sun);

    // Five stacked translucent planes at illustrative elevations.
    const planeGeo = new THREE.PlaneGeometry(LAYER_SIZE_WU, LAYER_SIZE_WU, 8, 8);
    const planes: THREE.Mesh[] = [];
    for (let layer = 0; layer < LAYER_COUNT; layer++) {
      const mat = new THREE.MeshBasicMaterial({
        color: 0x3a4a6a,
        transparent: true,
        opacity: 0.08,
        wireframe: true,
        side: THREE.DoubleSide,
      });
      const plane = new THREE.Mesh(planeGeo, mat);
      plane.rotation.x = -Math.PI / 2;
      plane.position.y = layer * LAYER_HEIGHT_WU;
      plane.userData.layer = layer;
      scene.add(plane);
      planes.push(plane);
    }

    type UnitType = keyof typeof TRANSITION_SECONDS;
    interface Unit {
      mesh: THREE.Object3D;
      type: UnitType;
      layer: number;
      fromY: number;
      toY: number;
      transitionStart: number;
      transitioning: boolean;
    }

    const units: Unit[] = [];
    let selected: Unit | null = null;

    const loader = new GLTFLoader();
    const toLoad: { type: UnitType; url: string; x: number; z: number; layer: number }[] = [
      { type: "raider", url: "/models/raider_t1.glb", x: -22, z: 0, layer: 1 },
      { type: "interceptor", url: "/models/interceptor_t1.glb", x: 0, z: 0, layer: 2 },
      { type: "vanguard", url: "/models/vanguard_t1.glb", x: 22, z: 0, layer: 1 },
    ];

    let loadedCount = 0;
    for (const spec of toLoad) {
      loader.load(
        spec.url,
        (gltf) => {
          const obj = gltf.scene;
          const box = new THREE.Box3().setFromObject(obj);
          const size = box.getSize(new THREE.Vector3());
          const scale = 10 / Math.max(size.x, size.y, size.z, 0.001);
          obj.scale.setScalar(scale);
          const y = spec.layer * LAYER_HEIGHT_WU;
          obj.position.set(spec.x, y, spec.z);
          obj.userData.unitType = spec.type;
          scene.add(obj);
          units.push({
            mesh: obj,
            type: spec.type,
            layer: spec.layer,
            fromY: y,
            toY: y,
            transitionStart: 0,
            transitioning: false,
          });
          loadedCount++;
          if (loadedCount === toLoad.length) {
            hint.textContent = "Click a unit to select it. [ and ] move it a layer.";
          }
        },
        undefined,
        (err) => {
          console.error("failed to load", spec.url, err);
          hint.textContent = `Failed to load ${spec.url}`;
        }
      );
    }

    function setLayerGrids() {
      for (const plane of planes) {
        const mat = plane.material as THREE.MeshBasicMaterial;
        if (!selected) {
          mat.opacity = 0.08;
          plane.scale.setScalar(1);
          continue;
        }
        const dist = Math.abs(plane.userData.layer - selected.layer);
        const factor = VISIBILITY_FACTOR[dist] ?? 0;
        mat.opacity = factor === 0 ? 0.03 : 0.12 + factor * 0.6;
        mat.color.set(factor > 0 ? 0xd98e3a : 0x3a4a6a);
        plane.scale.setScalar(factor > 0 ? 0.5 + factor * 0.5 : 1);
      }
    }

    function selectUnit(unit: Unit | null) {
      for (const u of units) {
        u.mesh.traverse((child) => {
          if ((child as THREE.Mesh).isMesh) {
            (child as THREE.Mesh & { userData: any }).userData.__outlined = u === unit;
          }
        });
      }
      selected = unit;
      setLayerGrids();
    }

    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    canvas.addEventListener("click", (event) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(pointer, camera);
      const meshes = units.map((u) => u.mesh);
      const hits = raycaster.intersectObjects(meshes, true);
      if (hits.length === 0) {
        selectUnit(null);
        return;
      }
      let obj: THREE.Object3D | null = hits[0].object;
      while (obj && !units.some((u) => u.mesh === obj)) obj = obj.parent;
      const unit = units.find((u) => u.mesh === obj) ?? null;
      selectUnit(unit);
    });

    function beginTransition(unit: Unit, direction: 1 | -1) {
      const nextLayer = unit.layer + direction;
      if (nextLayer < 0 || nextLayer >= LAYER_COUNT || unit.transitioning) return;
      unit.transitioning = true;
      unit.layer = nextLayer;
      unit.fromY = unit.mesh.position.y;
      unit.toY = nextLayer * LAYER_HEIGHT_WU;
      unit.transitionStart = performance.now();
      setLayerGrids();
    }

    window.addEventListener("keydown", (event) => {
      if (!selected) return;
      if (event.key === "[") beginTransition(selected, -1);
      if (event.key === "]") beginTransition(selected, 1);
    });

    function tickTransitions(now: number) {
      for (const unit of units) {
        if (!unit.transitioning) continue;
        const durationMs = TRANSITION_SECONDS[unit.type] * 1000;
        const t = Math.min(1, (now - unit.transitionStart) / durationMs);
        unit.mesh.position.y = unit.fromY + (unit.toY - unit.fromY) * t;
        if (t >= 1) unit.transitioning = false;
      }
    }

    function animate() {
      requestAnimationFrame(animate);
      tickTransitions(performance.now());
      controls.update();
      renderer.render(scene, camera);
    }

    resize();
    setLayerGrids();
    animate();
  </script>
</Base>
